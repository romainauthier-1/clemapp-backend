# Chaîne de connexion MongoDB (Atlas ou instance locale)
CONNECTION_STRING=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/clemapp

# Port d’écoute : laisser commenté, défaut 4000 (bin/www écoute aussi sur PORT)
# PORT=4000

# Clés VAPID pour les notifications push (générer avec : npx web-push generate-vapid-keys)
EXPO_PUBLIC_VAPID_PUBLIC_KEY=
EXPO_PUBLIC_VAPID_PRIVATE_KEY=

# Clé API OpenWeatherMap (météo affichée sur l'accueil)
EXPO_PUBLIC_OWM_API_KEY=
